# ================================================================
# KONFIGURASI ZIMAOS / PRODUCTION (PORT 3300)
# ================================================================
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=ganti-dengan-string-acak-panjang-rahasia-anda
DEBUG=false
ALLOWED_HOSTS=*

# Masukkan IP ZimaOS Anda agar form POST/Upload/Login diizinkan oleh Django CSRF
# Contoh: http://192.168.1.50:3300 atau http://zimaos.local:3300
CSRF_TRUSTED_ORIGINS=http://localhost:3300,http://127.0.0.1:3300,http://zimaos.local:3300

# Database Postgres di ZimaOS
DB_PASSWORD=laporan_rahasia_123
DATABASE_URL=postgres://laporan:laporan_rahasia_123@db:5432/laporan

# Akun Admin / Superuser Otomatis (opsional, otomatis dibuat saat startup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@laporan.local

# Nilai AWAL tanggal mulai siklus "bulan bisnis" (1-31), dipakai cuma sekali saat
# baris pengaturan pertama kali dibuat. Setelah itu ubah lewat halaman web
# /pengaturan/ (menu "Pengaturan", perlu login superuser) — ubah di sini TIDAK
# akan kepakai lagi begitu baris pengaturannya sudah ada di database.
BUSINESS_MONTH_START_DAY=1

# ================================================================
# OPSIONAL: UNTUK MODE DEVELOPMENT LOKAL (Mac / SQLite)
# ================================================================
# DJANGO_SETTINGS_MODULE=config.settings.dev
# DEBUG=true
# ALLOWED_HOSTS=localhost,127.0.0.1
